# Haroony AI Server Environment Variables (keep secrets ONLY on the server — NEVER commit .env to Git!)
# Haroony AI cascades across all configured backends and falls back cleanly to unlimited local Harony RAG.

# Cloud Multimodal Engines (optional, server-side only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Open-Source Cloud Inference Providers (optional, server-side only)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
HF_TOKEN=
HF_MODEL=Qwen/Qwen2.5-72B-Instruct
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Unlimited Self-Hosted Open-Source Ollama Pool (zero rate limits)
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-vl:7b

# Optional Custom OpenAI-Compatible Endpoint (vLLM / LocalAI / Together)
OPENAI_COMPAT_ENABLED=false
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# Teacher Admin PIN
HAROONY_TEACHER_PIN=0625
