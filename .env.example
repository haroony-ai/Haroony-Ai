# =====================================================================
# Haroony AI — Server-Side Configuration (.env)
# Copy this file to .env on your server (NEVER commit .env to Git).
# Or run: .venv/bin/python scripts/configure_keys.py
# =====================================================================

# Dual Engine Mode:
#   dual         = Use BOTH Gemini + OpenAI concurrently, verified against Harony RAG
#   gemini_first = Gemini primary with automatic OpenAI failover
#   openai_first = OpenAI primary with automatic Gemini failover
HAROONY_LLM_MODE=dual

# 1. Google Gemini (https://aistudio.google.com/apikey) — supports vision + tunedModels/...
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.5-flash

# 2. OpenAI (https://platform.openai.com/api-keys) — supports vision + fine-tuned ft:... models
OPENAI_API_KEYS=
OPENAI_MODEL=gpt-4o-mini

# 3. Teacher Mark-Scheme Grader PIN
HAROONY_TEACHER_PIN=0625

# 4. Optional Custom OpenAI-Compatible Endpoint
OPENAI_COMPAT_ENABLED=false
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
