# Haroony AI Server Environment Variables (keep secrets ONLY on the server — NEVER commit .env to Git!)
# Optional: if set on your private backend (e.g. Render / Railway / Fly.io / HuggingFace Spaces Secrets),
# Haroony AI uses hybrid routing across these models and falls back seamlessly to unlimited local Harony RAG + Ollama.

# Primary Cloud Model 1 (optional, server-side only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Primary Cloud Model 2 (optional, server-side only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Unlimited Self-Hosted Open-Source Model (optional, zero rate limits)
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-vl:7b

# Optional Custom OpenAI-Compatible Endpoint (Groq / Together / vLLM / LocalAI)
OPENAI_COMPAT_ENABLED=false
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# Teacher Admin PIN
HAROONY_TEACHER_PIN=0625
