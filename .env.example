# =====================================================================
# Haroony AI — Server-Side Configuration (.env)
# Copy this file to .env on your server (NEVER commit .env to Git).
# You can supply MULTIPLE comma-separated free-tier API keys per pool
# for automatic round-robin rotation & zero-downtime failover!
# =====================================================================

# 1. Free-Tier Open-Source Cloud APIs (Recommended — fast & generous free tiers)
# Groq (https://console.groq.com/keys)
GROQ_API_KEYS=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini Free Tier (https://aistudio.google.com/apikey) — supports vision/screenshots too!
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.5-flash

# Cerebras Free Tier (https://cloud.cerebras.ai/)
CEREBRAS_API_KEYS=
CEREBRAS_MODEL=llama-3.3-70b

# OpenRouter Free Models (https://openrouter.ai/keys)
OPENROUTER_API_KEYS=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# HuggingFace Inference Router (https://huggingface.co/settings/tokens)
HF_TOKENS=
HF_MODEL=Qwen/Qwen2.5-72B-Instruct

# Mistral Free Tier (https://console.mistral.ai/)
MISTRAL_API_KEYS=
MISTRAL_MODEL=mistral-small-latest

# 2. Optional Paid Cloud Vision/Reasoning
OPENAI_API_KEYS=
OPENAI_MODEL=gpt-4o-mini

# 3. Unlimited Local / Self-Hosted Open-Source LLM (Ollama)
# Auto-discovers installed models (qwen2.5-vl, qwen2.5, llama3.2, deepseek-r1, mistral, phi4)
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-vl:7b

# 4. Optional Custom OpenAI-Compatible Endpoint (vLLM, LocalAI, Together, etc.)
OPENAI_COMPAT_ENABLED=false
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
