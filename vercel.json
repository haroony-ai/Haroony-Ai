{
  "version": 2,
  "cleanUrls": true,
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60,
      "includeFiles": "{static/browser_kb.json,static/browser_qa.json,static/browser_engine.js,data/training/gemini_sft_dataset.jsonl,data/training/openai_sft_dataset.jsonl}"
    }
  },
  "rewrites": [
    { "source": "/api/status", "destination": "/api/status" },
    { "source": "/api/chat", "destination": "/api/chat" },
    { "source": "/api/feedback", "destination": "/api/feedback" },
    { "source": "/api/notes", "destination": "/api/notes" },
    { "source": "/api/admin/train", "destination": "/api/admin/train" }
  ]
}
